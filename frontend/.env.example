# Copy to frontend/.env and fill in. Only public values belong here:
# everything prefixed VITE_ is shipped to the browser.

VITE_API_URL=http://localhost:8000

# Supabase project URL and the public anon key (never a service-role key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to "off" only together with CADASTRA_AUTH=off on the backend, for
# local development without signing in. The app shows a DEV SESSION notice.
# VITE_AUTH_MODE=off
