# Copy to backend/.env and fill in. Never commit the real file.

# --- Authentication (Supabase) -------------------------------------------
# Project URL and the public *anon* key. Do not put a service-role key here:
# the backend only asks Supabase who an access token belongs to.
SUPABASE_URL=
SUPABASE_KEY=

# "supabase" verifies every request. "off" disables authentication for
# local development only (every request becomes a labelled dev session).
CADASTRA_AUTH=supabase

# Signed-in users with no assignment of their own see the registry's demo
# assignment, labelled DEMO. Set to false to require a real assignment.
CADASTRA_ALLOW_DEMO_ASSIGNMENT=true

# --- Web -----------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173,https://your-domain.example

# --- Paths (defaults shown) -----------------------------------------------
# CADASTRA_DATA_DIR=backend/data
# CADASTRA_PROCESSING_DIR=backend/processing
# CADASTRA_MODEL_PATH=backend/models/best_weighted_multiclass_unet.pth

# --- AI pipeline ----------------------------------------------------------
# Must match training. scale_255 = x/255 (default, see docs/architecture.md);
# imagenet = (x/255 - mean) / std.
MODEL_NORMALIZATION=scale_255
TILE_SIZE=512
TILE_OVERLAP=64
POLYGONIZE_CHUNK=4096
SIEVE_MIN_PIXELS=8
EXPORT_BACKGROUND=false
MAX_UPLOAD_MB=4096

# --- GIS thresholds ---------------------------------------------------------
SLIVER_AREA_M2=1.0
MIN_CANDIDATE_PARCEL_M2=25
ROAD_ACCESS_DISTANCE_M=5
MAP_FEATURE_LIMIT=4000
